#!/bin/sh
# Admin wrapper, installed as /usr/local/sbin/box-server:
# loads the configuration and runs the CLI as the service user.
#   box-server migrate | create-admin --email … --tenant-name …
set -eu
set -a
. /etc/box-server/box-server.env
set +a
cd /opt/box-server
exec runuser -u box-server -- /opt/box-server/.venv/bin/box-server "$@"
