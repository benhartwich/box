# /etc/box-server/box-server.env  (root:box-server, 0640)
# All settings: server/src/box_server/settings.py

BOX_SERVER_ENV=prod
# Public URL; also used for the CSRF Origin check and links in mails.
BOX_SERVER_BASE_URL=https://box.example.org

# PostgreSQL via Unix socket with peer authentication (no password).
BOX_SERVER_DATABASE_URL=postgresql://box-server@/box-server?host=/run/postgresql

# HS256 key for device tokens, at least 32 bytes: openssl rand -base64 48
BOX_SERVER_DEVICE_JWT_KEY=CHANGE-ME

BOX_SERVER_DATA_DIR=/var/lib/box-server
# nginx internal location (deploy/nginx/box-server.conf)
BOX_SERVER_ACCEL_REDIRECT_PREFIX=/_assets/
BOX_SERVER_TRUST_PROXY_HEADERS=true
BOX_SERVER_MAX_UPLOAD_MB=500

# Mail: "log" shows invitation links in the UI instead of sending them.
BOX_SERVER_MAIL_BACKEND=log
#BOX_SERVER_MAIL_BACKEND=smtp
#BOX_SERVER_MAIL_FROM=Box <box@example.org>
#BOX_SERVER_SMTP_HOST=smtp.example.org
#BOX_SERVER_SMTP_PORT=587
#BOX_SERVER_SMTP_USER=box@example.org
#BOX_SERVER_SMTP_PASSWORD=CHANGE-ME
#BOX_SERVER_SMTP_STARTTLS=true

BOX_SERVER_WORKER_CONCURRENCY=1
BOX_SERVER_LOG_LEVEL=INFO
BOX_SERVER_LOG_FORMAT=json
