# Self-hosting with Docker Compose: copy to .env and fill in (docs/selbst-hosten.md).
# Keep .env private (chmod 600): it holds the database password and the device key.

# The name under which boxes and browsers reach the server; the certificate must match it.
MYBOXI_DOMAIN=myboxi.example.org
# Only if HTTPS is published on a port other than 443: https://myboxi.example.org:8443
#MYBOXI_BASE_URL=
#MYBOXI_HTTP_PORT=80
#MYBOXI_HTTPS_PORT=443
# Only on one address of this computer, e.g. its home network address; default: all
#MYBOXI_LISTEN=192.168.1.20
# fullchain.pem and privkey.pem (and myboxi-ca.pem with an own CA); default ./certs
#MYBOXI_CERTS_DIR=./certs

# Secrets, created once:
#   sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 24)|" .env
#   sed -i "s|^MYBOXI_DEVICE_JWT_KEY=.*|MYBOXI_DEVICE_JWT_KEY=$(openssl rand -base64 48 | tr -d '\n')|" .env
POSTGRES_PASSWORD=
MYBOXI_DEVICE_JWT_KEY=

# Optional parts: mqtt (instant sync and remote control, port 8883), letsencrypt
# (certificate via HTTP-01, needs ports 80 and 443 from the internet). Comma-separated.
#COMPOSE_PROFILES=mqtt,letsencrypt

# Profile mqtt: the broker's admin password
#   sed -i "s|^MYBOXI_MQTT_PASSWORD=.*|MYBOXI_MQTT_PASSWORD=$(openssl rand -hex 32)|" .env
MYBOXI_MQTT_PASSWORD=
#MYBOXI_MQTT_PORT=8883

# Profile letsencrypt: for Let's Encrypt's expiry notices
MYBOXI_LETSENCRYPT_EMAIL=

# Mail: "log" shows invitation links in the web UI instead of sending them.
MYBOXI_MAIL_BACKEND=log
#MYBOXI_MAIL_BACKEND=smtp
#MYBOXI_MAIL_FROM=Myboxi <noreply@example.org>
#MYBOXI_SMTP_HOST=smtp.example.org
#MYBOXI_SMTP_PORT=587
#MYBOXI_SMTP_USER=myboxi@example.org
#MYBOXI_SMTP_PASSWORD=

#MYBOXI_MAX_UPLOAD_MB=500
#MYBOXI_LOG_LEVEL=INFO
