# /etc/myboxi-server/myboxi-server.env  (root:myboxi-server, 0640)
# All settings: server/src/myboxi_server/settings.py

MYBOXI_SERVER_ENV=prod
# Public URL; also used for the CSRF Origin check and links in mails.
MYBOXI_SERVER_BASE_URL=https://myboxi.example.org

# PostgreSQL via Unix socket with peer authentication (no password).
MYBOXI_SERVER_DATABASE_URL=postgresql://myboxi-server@/myboxi-server?host=/run/postgresql

# HS256 key for device tokens, at least 32 bytes: openssl rand -base64 48
MYBOXI_SERVER_DEVICE_JWT_KEY=CHANGE-ME

MYBOXI_SERVER_DATA_DIR=/var/lib/myboxi-server
# nginx internal location (deploy/nginx/myboxi-server.conf)
MYBOXI_SERVER_ACCEL_REDIRECT_PREFIX=/_assets/
MYBOXI_SERVER_TRUST_PROXY_HEADERS=true
MYBOXI_SERVER_MAX_UPLOAD_MB=500

# Mail: "log" shows invitation links in the UI instead of sending them.
MYBOXI_SERVER_MAIL_BACKEND=log
#MYBOXI_SERVER_MAIL_BACKEND=smtp
#MYBOXI_SERVER_MAIL_FROM=Myboxi <myboxi@example.org>
#MYBOXI_SERVER_SMTP_HOST=smtp.example.org
#MYBOXI_SERVER_SMTP_PORT=587
#MYBOXI_SERVER_SMTP_USER=myboxi@example.org
#MYBOXI_SERVER_SMTP_PASSWORD=CHANGE-ME
#MYBOXI_SERVER_SMTP_STARTTLS=true

MYBOXI_SERVER_WORKER_CONCURRENCY=1
MYBOXI_SERVER_LOG_LEVEL=INFO
MYBOXI_SERVER_LOG_FORMAT=json
