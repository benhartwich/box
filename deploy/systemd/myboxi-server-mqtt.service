# The one process that talks to the MQTT broker (SPEC §6): box accounts, notify, commands.
[Unit]
Description=Myboxi server MQTT service
After=network-online.target postgresql.service mosquitto.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=myboxi-server
Group=myboxi-server
EnvironmentFile=/etc/myboxi-server/myboxi-server.env
# The broker's admin password only here, not in the API's or the worker's environment.
EnvironmentFile=/etc/myboxi-server/mqtt.env
WorkingDirectory=/opt/myboxi-server
ExecStart=/opt/myboxi-server/.venv/bin/myboxi-server mqtt
Restart=always
RestartSec=5
UMask=0027
MemoryMax=256M
TasksMax=64

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
