# Myboxi agent (SPEC v0.5 §4). All settings: agent/src/myboxi_agent/config.py
MYBOXI_AGENT_DATA_DIR=/var/lib/myboxi
MYBOXI_AGENT_DEFAULT_SERVER_URL=https://app.myboxi.eu
MYBOXI_AGENT_PROMPTS_DIR=/opt/myboxi-agent/current/prompts
MYBOXI_AGENT_AUDIO_OUTPUT=pipewire
MYBOXI_AGENT_LOG_FORMAT=json
MYBOXI_AGENT_LOG_LEVEL=INFO
