# Installs or updates Spotify Soloist (SPEC v0.9 §8.1) from Spotify's official download.
# Does nothing unless Spotify is switched on for the box and a key is stored.
[Unit]
Description=Install or update Spotify Soloist for Myboxi
ConditionUser=myboxi

[Service]
Type=oneshot
EnvironmentFile=/etc/myboxi-agent/myboxi-agent.env
WorkingDirectory=/var/lib/myboxi
ExecStart=/opt/myboxi-agent/current/.venv/bin/myboxi-agent soloist update
Nice=10
NoNewPrivileges=yes
TimeoutStartSec=15min
